{
	"name": "funkin-compiler",
	"publisher": "mikolka9144",
	"displayName": "Funkin IDE",
	"version": "0.8.2",
	"description": "A complete environment for making \"Friday Night Funkin'\" (V-Slice) mods!",
	"categories": [
		"Programming Languages",
		"Formatters",
		"Debuggers",
		"Linters"
	],
	"galleryBanner": {
		"theme": "dark",
		"color": "#cc2c9e"
	},
	"icon": "assets/icon.png",
	"license": "GPL-3.0",
	"bugs": "https://github.com/mikolka9144/funkin-extension/issues",
	"homepage": "https://github.com/mikolka9144/funkin-extension/blob/main/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/mikolka9144/funkin-extension.git"
	},
	"capabilities": {
		"virtualWorkspaces": {
			"supported": false,
			"description": "It doesn't work"
		},
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": ""
		}
	},
	"engines": {
		"vscode": "^1.74.0"
	},
	"extensionDependencies": [
		"nadako.vshaxe"
	],
	"activationEvents": [
		"workspaceContains:./_polymod_meta.json",
		"workspaceContains:./exclude/ui/credits/credits.json"
	],
	"files": [
		"bin",
		"assets",
		"debug-mod",
		"LICENSE.md"
	],
	"main": "bin/main.js",
	"contributes": {
		"configuration": [
			{
				"title": "Funkin IDE",
				"properties": {
					"funkinCompiler.gamePath": {
						"description": "A path to your FNF V-Slice instance. It is recommended to use relative paths here, but absolute should also work.",
						"type": "string",
						"default": ""
					},
					"funkinCompiler.debug": {
						"description": "Enable debug utilities and additional output.",
						"type": "boolean",
						"default": "false"
					},
					"funkinCompiler.haxelibPath": {
						"description": "A path to the haxelib folder used by the compiler. Use the setup command to initialise this field (unless you already have one initialised).",
						"type": "string",
						"default": ""
					},
					"funkinCompiler.fcpkgSources": {
						"description": "List of sources providing fcPkg manifests",
						"type": "array",
						"default": [
							"https://raw.githubusercontent.com/FunkinCompiler/fcpkg-cdn/refs/heads/master/full-sources.json"
						]
					}
				}
			}
		],
		"commands": [
			{
				"command": "mikolka.setup",
				"category": "Funkin FCPKG",
				"title": "Setup haxelib"
			},
			{
				"command": "mikolka.new",
				"category": "Funkin compiler",
				"title": "Make new project"
			},
			{
				"command": "mikolka.setHaxelib",
				"category": "Funkin FCPKG",
				"title": "Set haxelib"
			},
			{
				"command": "mikolka.haxelib.inspect",
				"category": "Funkin FCPKG",
				"title": "Open Installed haxelibs"
			}
		],
		"jsonValidation": [
			{
				"fileMatch": [
					"**/_merge/**/*.json"
				],
				"url": "./assets/jsonc/_merge.json"
			},
			{
				"fileMatch": [
					"!**/_merge/**/*.json",
					"**/_polymod_meta.json"
				],
				"url": "./assets/jsonc/_polymod_meta.json"
			},
			{
				"fileMatch": [
					"!**/_merge/**/*.json",
					"**/ui/mods/characters/*.json"
				],
				"url": "./assets/jsonc/data/mods/characters.json"
			},
			{
				"fileMatch": [
					"**/ui/story-mode/levels/*.json",
					"**/data/levels/*.json",
					"!**/_merge/**/*.json"
				],
				"url": "./assets/jsonc/data/levels.json"
			},
			{
				"fileMatch": [
					"**/data/notestyles/*.json",
					"**/gameplay/notestyles/*/*.json",
					"!**/_merge/**/*.json"
				],
				"url": "./assets/jsonc/data/notestyles.json"
			},
			{
				"fileMatch": [
					"!**/_merge/**/*.json",
					"**/data/stages/*.json",
					"**/gameplay/stages/*/*.json"
				],
				"url": "./assets/jsonc/data/stages.json"
			},
			{
				"fileMatch": [
					"!**/_merge/**/*.json",
					"**/data/characters/*.json",
					"**/gameplay/characters/*/*.json"
				],
				"url": "./assets/jsonc/data/characters.json"
			},
			{
				"fileMatch": [
					"!**/_merge/**/*.json",
					"**/data/players/*.json",
					"**/gameplay/playable-characters/*/*.json"
				],
				"url": "./assets/jsonc/data/players.json"
			},
			{
				"fileMatch": [
					"!**/_merge/**/*.json",
					"**/data/songs/*/*-chart*.json",
					"**/gameplay/songs/*/*-chart*.json"
				],
				"url": "./assets/jsonc/data/songs/chart.json"
			},
			{
				"fileMatch": [
					"!**/_merge/**/*.json",
					"**/data/songs/*/*-metadata*.json",
					"**/gameplay/songs/*/*-metadata*.json"
				],
				"url": "./assets/jsonc/data/songs/metadata.json"
			},
			{
				"fileMatch": [
					"**/ui/freeplay/albums/*.json"
				],
				"url": "./assets/jsonc/data/freeplay/albums.json"
			},
			{
				"fileMatch": [
					"!**/_merge/**/*.json",
					"**/ui/freeplay/styles/*/*.json",
					"**/ui/freeplay/styles/*.json"
				],
				"url": "./assets/jsonc/data/freeplay/styles.json"
			},
			{
				"fileMatch": [
					"!**/_merge/**/*.json",
					"**/data/stickerpacks/*.json",
					"**/ui/loading/stickers/stickerpacks/*.json"
				],
				"url": "./assets/jsonc/data/stickerpacks.json"
			},
			{
				"fileMatch": [
					"!**/_merge/**/*.json",
					"**/dialogue/speakers/*.json",
					"**/dialogue/speakers/*/*.json"
				],
				"url": "./assets/jsonc/data/dialogue/speaker.json"
			},
			{
				"fileMatch": [
					"!**/_merge/**/*.json",
					"**/dialogue/boxes/*.json",
					"**/dialogue/boxes/*/*.json"
				],
				"url": "./assets/jsonc/data/dialogue/dialogue_box.json"
			},
			{
				"fileMatch": [
					"!**/_merge/**/*.json",
					"**/dialogue/conversations/*.json",
					"**/dialogue/conversations/*/*.json"
				],
				"url": "./assets/jsonc/data/dialogue/conversation.json"
			},
			{
				"fileMatch": [
					"**/*-metadata.json",
					"!**/_merge/**/*.json",
					"!**/data/songs/*/*-metadata*.json",
					"!**/gameplay/songs/*/*-metadata*.json"
				],
				"url": "./assets/jsonc/music/music-metadata.json"
			}
		],
		"taskDefinitions": [
			{
				"type": "funk-mobile",
				"required": [],
				"properties": {
					"modName": {
						"type": "string",
						"description": "THe name to use for the mod. If you have the mod with the same name, this task will override it!"
					},
					"packageName": {
						"type": "string",
						"default": "me.funkin.fnf",
						"description": "The package name of FNF mobile to copy the files into."
					}
				}
			},
			{
				"type": "funk-pc",
				"required": [],
				"properties": {
					"modName": {
						"type": "string",
						"description": "THe name to use for the mod. If you have the mod with the same name, this task will override it!"
					}
				}
			}
		],
		"debuggers": [
			{
				"type": "funkin-run-game",
				"label": "Run the FNF: V-Slice instance",
				"program": "./bin/funkin-runner.js",
				"runtime": "node",
				"configurationAttributes": {
					"launch": {
						"properties": {
							"cwd": {
								"type": "string",
								"description": "Path to the current working directory. If not specified, the workspace directory is used."
							},
							"cmd_prefix": {
								"type": "string",
								"description": "Prefix to use in the command."
							},
							"execName": {
								"type": "string",
								"description": "Name of the executable. (if 'isMobile' is set to true, put here a package name instead, like 'me.funkin.fnf')"
							},
							"args": {
								"type": "array",
								"description": "The Haxe command-line arguments. If not specified, the selected Haxe configuration is used",
								"items": {
									"type": "string"
								}
							},
							"trace": {
								"type": "boolean",
								"description": "Traces some other output.",
								"default": true
							},
							"isMobile": {
								"type": "boolean",
								"description": "If true, rund the debugger on the connected android device instead (via adb)",
								"default": false
							},
							"attachDebugger": {
								"type": "boolean",
								"description": "If true, will install a companion mod to help with debugging",
								"default": true
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"name": "Compile & Launch current mod",
						"type": "funkin-run-game",
						"request": "launch"
					}
				],
				"configurationSnippets": [
					{
						"type": "funkin-run-game",
						"request": "launch",
						"name": "Copy & Run PC FNF",
						"preLaunchTask": "Funk: Copy this V-Slice mod to local FNF"
					},
					{
						"type": "funkin-run-game",
						"request": "launch",
						"name": "Copy & Run Mobile FNF",
						"isMobile": true,
						"preLaunchTask": "Funk ADB: Copy this V-Slice mod to mobile"
					},
					{
						"type": "funkin-run-game",
						"request": "launch",
						"name": "Just run FNF",
						"preLaunchTask": ""
					}
				]
			}
		]
	},
	"dependencies": {
		"vscode-debugadapter": "^1.48.0",
		"vscode-debugprotocol": "^1.48.0"
	},
	"devDependencies": {
		"@vercel/ncc": "^0.33.4",
		"uglify-js":"^3.19.3"
	},
	"scripts": {
		"publish": "vsce publish && ovsx publish",
		"vscode:prepublish": "npm run haxe && npm run bundle && npm run pack",
		"test": "npm run haxe && npm run bundle-debug-runner && npm run bundle-debug-main",
		"haxe": "haxe ./extension.hxml && haxe ./funkin-runner.hxml",
		"bundle": "npm run bundle-runner && npm run bundle-main",
		"bundle-main": "npx ncc build bin/main.js -o . -q && mv index.js ./bin/main.js",
		"bundle-runner": "npx ncc build bin/funkin-runner.js -o . -q && mv index.js ./bin/funkin-runner.js",
		"pack": "npm run pack-runner && npm run pack-main",
		"pack-runner": "npx uglify-js bin/funkin-runner.js -o bin/funkin-runner.js -m -c",
		"pack-main": "npx uglify-js bin/main.js -o bin/main.js -m -c"
	},
	"extensionPack": [
		"gert7.srt-subrip",
		"dtoplak.vscode-glsllint"
	]
}
